---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import heroImage from '@assets/heroes/malue-home-hero.png';
---

<Layout>
  <Hero
    eyebrow="Investors"
    titleHtml="Investing in better healthcare decisions"
    description="Healthcare spends billions each year on innovation, digital transformation and operational improvement. Yet too many valuable ideas never move beyond local success because organisations struggle to capture frontline knowledge, evaluate opportunities consistently, implement change and measure impact."
    imageAlt="Investor strategy illustration"
    imageSrc={heroImage}
  />
</Layout>
