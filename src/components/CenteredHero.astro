---
import heroImage from "../assets/background.svg";
import { Image } from "astro:assets";

export interface Props {
  title?: string;
  titleHtml?: string;
  description?: string;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
  imageAlt?: string;
  imageSrc?: any;
}

const {
  title = "Partner with Malue to unlock better value and growth.",
  titleHtml,
  description = "We design strategic collaborations, launch new products, and create stronger customer experiences across every channel. Let’s build something exceptional together.",
  primaryText = "Partner With Us",
  primaryHref = "#",
  secondaryText = "Learn More",
  secondaryHref = "#",
  imageAlt = "Illustration of growth and collaboration",
  imageSrc,
} = Astro.props as Props;
---

<div class="wrapper">
  <section class="centered-hero">
    <div class="hero-copy">
      {titleHtml ? <h1 set:html={titleHtml} /> : <h1>{title}</h1>}
      <p>{description}</p>
      <div class="hero-actions">
        <a href={primaryHref} class="button primary">{primaryText}</a>
        <a href={secondaryHref} class="button secondary">{secondaryText}</a>
      </div>
    </div>

    <div class="hero-visual">
      <Image src={imageSrc ?? heroImage} alt={imageAlt} />
    </div>
  </section>
</div>

<style>
  .centered-hero {
    display: grid;
    place-items: center;
    text-align: center;
    gap: 40px;
  }

  .hero-copy {
  }

  h1 {
    margin: 0 0 24px;
    /* max-width: 920px; */
    font-weight: 500;
    text-wrap: balance;
    font-size: clamp(2.75rem, 5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: #0f172a;
  }

  .hero-copy p {
    margin: 0 auto 25px;
    max-width: calc(var(--site-max-width) - 300px);
    line-height: 1.8;
    color: #334155;
    font-size: 1.05rem;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 26px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-1px);
  }

  .primary {
    background: var(--brand-cta);
    color: #ffffff;
  }

  .secondary {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.12);
    color: #0f172a;
  }

  .hero-visual img {
    width: 100%;
    aspect-ratio: 2.3 / 1;
    object-fit: cover;
    height: auto;
    border-radius: 25px;
    box-shadow: 0 28px 80px rgba(15, 23, 42, 0.12);
  }

  @media screen and (max-width: 640px) {
    .centered-hero {
      gap: 30px;
    }

    .hero-copy p {
      font-size: 1rem;
    }
  }
</style>
