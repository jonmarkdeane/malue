---
import { Image } from "astro:assets";
import heroImage from "@assets/background.svg";
import Button from "@components/Button.astro";

export interface Props {
  eyebrow?: string;
  title?: string;
  titleHtml?: string;
  description?: string;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
  imageAlt?: string;
  imageSrc?: any;
}

const {
  eyebrow = "Eyebrow",
  title = "Title",
  titleHtml,
  description = "Some blurb",
  primaryText,
  primaryHref,
  secondaryText,
  secondaryHref,
  imageAlt = "Illustration of growth and collaboration",
  imageSrc,
} = Astro.props as Props;
---

<div class="wrapper">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      {titleHtml ? <h1 set:html={titleHtml} /> : <h1>{title}</h1>}
      <p>{description}</p>
      {
        primaryHref && (
          <div class="hero-actions">
            <Button href={primaryHref ?? "#"} appearance="primary">
              {primaryText ?? "Partner With Us"}
            </Button>
            <Button href={secondaryHref ?? "#"} appearance="secondary">
              {secondaryText ?? "Learn More"}
            </Button>
          </div>
        ) 
      }
    </div>

    <div class="hero-visual">
      <Image src={imageSrc ?? heroImage} alt={imageAlt} />
    </div>
  </section>
</div>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 48px;
  }

  .hero-copy {
    max-width: 620px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #d97706;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }

  h1 {
    margin: 0 0 24px;
    font-weight: 500;
    font-size: clamp(2.75rem, 5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: #0f172a;
  }

  .hero-copy p {
    text-wrap: balance;
    margin: 0;
    max-width: 560px;
    line-height: 1.8;
    color: #334155;
    font-size: 1.05rem;
  }

  .hero-actions {
    margin: 20px 0 0;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .hero-visual img {
    width: 100%;
    height: auto;
    border-radius: 32px;
    box-shadow: 0 28px 80px rgba(15, 23, 42, 0.12);
  }

  @media screen and (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-actions {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 640px) {
    .hero {
      gap: 32px;
    }

    .hero-copy p {
      font-size: 1rem;
    }
  }
</style>
