---
export interface Props {
  appearance?: "primary" | "secondary";
  href?: string;
  type?: "button" | "submit" | "reset";
  target?: string;
  rel?: string;
  disabled?: boolean;
  class?: string;
}

const {
  appearance = "primary",
  href,
  type = "button",
  target,
  rel,
  disabled = false,
  class: className = "",
} = Astro.props as Props;

const computedRel = target === "_blank" ? rel ?? "noopener noreferrer" : rel;
const buttonClass = `button button--${appearance} ${className}`.trim();
---

{href ? (
  <a
    class={buttonClass}
    href={href}
    target={target}
    rel={computedRel}
  >
    <slot />
  </a>
) : (
  <button class={buttonClass} type={type} disabled={disabled}>
    <slot />
  </button>
)}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 26px;
    border-radius: 999px;
    border: none;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-1px);
  }

  .button--primary {
    background: var(--brand-cta);
    color: #ffffff;
    position: relative;
  }

  .button--primary::after {
    content: '→';
    display: inline-block;
    margin-left: 0.75rem;
    font-weight: 700;
    transition: transform 0.2s ease;
  }

  .button:hover.button--primary::after,
  .button:focus-visible.button--primary::after {
    transform: translateX(2px);
  }

  .button--secondary {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.12);
    color: #0f172a;
  }

  .button:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
  }
</style>
