---
import logo from '../assets/maluelogo.svg';
import Nav from './Nav.astro';

---

<header class="site-header">
  <div class="header-wrapper">
    <a class="logo" href="/">
      <img src={logo.src} alt="Malue logo" width="200" />
    </a>

    <Nav />
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    width: 100%;
	height: 150px;
    background: rgba(255, 255, 255, 0.9);
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
  }
  .header-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 20px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(18px);
    position: sticky;
    top: 0;
    z-index: 20;
    width: 100%;
    max-width: var(--site-max-width);
    margin: 0 auto;
  }

  .logo {
    display: inline-flex;
    text-decoration: none;
  }

  .logo img {
    display: block;
    width: 200px;
    height: auto;
  }

  @media screen and (max-width: 768px) {
    .site-header {
      height: 100px;
    }

    .logo img {
      width: 140px;
    }
  }
</style>
