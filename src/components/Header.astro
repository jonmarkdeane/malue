---
import logo from '../assets/maluelogo.svg';

---

<header class="site-header">
  <div class="header-wrapper">
    <a class="logo" href="/">
      <img src={logo.src} alt="Malue logo" width="200" />
    </a>

    <input
      type="checkbox"
      id="menu-toggle"
      aria-label="Toggle navigation menu"
    />
    <label for="menu-toggle" class="menu-button" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <nav class="nav-menu" aria-label="Primary navigation">
      <div class="nav-links">
        <a href="#" class="nav-link">Home</a>
        <details class="nav-group">
          <summary class="nav-link nav-summary">What we do</summary>
          <div class="submenu-panel">
            <a href="#" class="dropdown-link">Item</a>
            <a href="#" class="dropdown-link">Item</a>
            <a href="#" class="dropdown-link">Item</a>
          </div>
        </details>
        <details class="nav-group">
          <summary class="nav-link nav-summary">How we work</summary>
          <div class="submenu-panel">
            <a href="#" class="dropdown-link">Item</a>
            <a href="#" class="dropdown-link">Item</a>
            <a href="#" class="dropdown-link">Item</a>
          </div>
        </details>
        <details class="nav-group">
          <summary class="nav-link nav-summary">Investors</summary>
          <div class="submenu-panel">
            <a href="#" class="dropdown-link">Item</a>
            <a href="#" class="dropdown-link">Item</a>
            <a href="#" class="dropdown-link">Item</a>
          </div>
        </details>
        <a href="#" class="nav-link">Contact</a>
      </div>
      <a href="#" class="cta-button">Partner With Us</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    width: 100%;
	height: 150px;
    background: rgba(255, 255, 255, 0.9);
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
  }
  .header-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 20px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(18px);
    position: sticky;
    top: 0;
    z-index: 20;
    width: 100%;
    max-width: var(--site-max-width);
    margin: 0 auto;
  }

  .logo {
    display: inline-flex;
    text-decoration: none;
  }

  .logo img {
    display: block;
    width: 200px;
    height: auto;
  }

  input#menu-toggle {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .menu-button {
    display: none;
    width: 40px;
    height: 32px;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
  }

  .menu-button span {
    display: block;
    height: 3px;
    border-radius: 999px;
    background: #111827;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 24px;
    flex: 1;
    min-width: 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex: 1;
    min-width: 0;
  }

  .nav-group {
    position: relative;
  }

  .nav-summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    position: relative;
  }

  .nav-summary::after {
    content: '▾';
    font-size: 1rem;
    display: inline-block;
    transform: translateY(1px);
    color: #64748b;
  }

  .nav-group[open] .nav-summary::after {
    transform: translateY(1px) rotate(180deg);
  }

  .nav-summary::-webkit-details-marker {
    display: none;
  }

  .submenu-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 16px;
    background: white;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    box-shadow: 0 22px 45px rgba(15, 23, 42, 0.12);
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    min-width: 170px;
  }

  .nav-group[open] .submenu-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .dropdown-link {
    text-decoration: none;
    color: #475569;
    font-size: 0.95rem;
    padding: 8px 0;
    transition: color 0.2s ease;
  }

  .dropdown-link:hover,
  .dropdown-link:focus-visible {
    color: #0f172a;
  }

  .nav-link {
    text-decoration: none;
    color: #334155;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-summary:hover,
  .nav-summary:focus-visible {
    color: #111827;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--brand-cta);
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .cta-button:hover,
  .cta-button:focus-visible {
    background: #b5b5b5;
    transform: translateY(-1px);
  }

  @media screen and (max-width: 768px) {
	.site-header {
	  height: 100px;
	}

    .menu-button {
      display: inline-flex;
    }

    .nav-menu {
      position: absolute;
      top: 100%;
      right: 18px;
      left: 18px;
      flex-direction: column;
      gap: 12px;
      padding: 16px 18px;
      background: rgba(255, 255, 255, 0.98);
      border: 1px solid rgba(15, 23, 42, 0.08);
      border-radius: 18px;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition:
        opacity 0.25s ease,
        transform 0.25s ease;
    }

    .logo img {
      width: 140px;
    }

    .cta-button {
      width: 100%;
      justify-content: center;
    }

    .cta-button {
      width: 100%;
      justify-content: center;
    }

    .nav-menu .nav-group {
      position: static;
    }

    .nav-menu .submenu-panel {
      position: static;
      transform: none;
      opacity: 1;
      pointer-events: auto;
      border: none;
      box-shadow: none;
      padding: 0;
      background: transparent;
      min-width: unset;
    }

    .nav-summary {
      padding: 0;
    }

    input#menu-toggle:checked + .menu-button + .nav-menu {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }
</style>
