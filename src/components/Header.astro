---
---
<header class="site-header">
	<a class="logo" href="/">Malue</a>

	<input type="checkbox" id="menu-toggle" aria-label="Toggle navigation menu" />
	<label for="menu-toggle" class="menu-button" aria-hidden="true">
		<span></span>
		<span></span>
		<span></span>
	</label>

	<nav class="nav-menu" aria-label="Primary navigation">
		<a href="#" class="nav-link">Home</a>
		<details class="nav-group">
			<summary class="nav-link nav-summary">Products</summary>
			<div class="submenu-panel">
				<a href="#" class="dropdown-link">Studio</a>
				<a href="#" class="dropdown-link">API</a>
				<a href="#" class="dropdown-link">Pricing</a>
			</div>
		</details>
		<details class="nav-group">
			<summary class="nav-link nav-summary">Resources</summary>
			<div class="submenu-panel">
				<a href="#" class="dropdown-link">Blog</a>
				<a href="#" class="dropdown-link">Guides</a>
				<a href="#" class="dropdown-link">Support</a>
			</div>
		</details>
		<a href="#" class="nav-link">Contact</a>
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 18px 24px;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(18px);
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid rgba(15, 23, 42, 0.08);
		width: 100%;
		max-width: 1440px;
		margin: 0 auto;
	}

	.logo {
		font-size: 1.15rem;
		font-weight: 700;
		color: #111827;
		text-decoration: none;
	}

	input#menu-toggle {
		position: absolute;
		opacity: 0;
		width: 0;
		height: 0;
		pointer-events: none;
	}

	.menu-button {
		display: none;
		width: 40px;
		height: 32px;
		flex-direction: column;
		justify-content: space-between;
		cursor: pointer;
	}

	.menu-button span {
		display: block;
		height: 3px;
		border-radius: 999px;
		background: #111827;
	}

	.nav-menu {
		display: flex;
		gap: 24px;
		align-items: center;
	}

	.nav-group {
		position: relative;
	}

	.nav-summary {
		list-style: none;
		cursor: pointer;
	}

	.nav-summary::-webkit-details-marker {
		display: none;
	}

	.submenu-panel {
		position: absolute;
		top: calc(100% + 10px);
		left: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 14px 16px;
		background: white;
		border: 1px solid rgba(15, 23, 42, 0.08);
		border-radius: 16px;
		box-shadow: 0 22px 45px rgba(15, 23, 42, 0.12);
		opacity: 0;
		pointer-events: none;
		transform: translateY(8px);
		transition: opacity 0.2s ease, transform 0.2s ease;
		min-width: 170px;
	}

	.nav-group[open] .submenu-panel {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	.dropdown-link {
		text-decoration: none;
		color: #475569;
		font-size: 0.95rem;
		padding: 8px 0;
		transition: color 0.2s ease;
	}

	.dropdown-link:hover,
	.dropdown-link:focus-visible {
		color: #0f172a;
	}

	.nav-link {
		text-decoration: none;
		color: #334155;
		font-weight: 500;
		transition: color 0.2s ease;
	}

	.nav-link:hover,
	.nav-link:focus-visible,
	.nav-summary:hover,
	.nav-summary:focus-visible {
		color: #111827;
	}

	@media screen and (max-width: 768px) {
		.site-header {
			padding: 16px 18px;
		}

		.menu-button {
			display: inline-flex;
		}

		.nav-menu {
			position: absolute;
			top: 100%;
			right: 18px;
			left: 18px;
			flex-direction: column;
			gap: 12px;
			padding: 16px 18px;
			background: rgba(255, 255, 255, 0.98);
			border: 1px solid rgba(15, 23, 42, 0.08);
			border-radius: 18px;
			box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
			opacity: 0;
			pointer-events: none;
			transform: translateY(-8px);
			transition: opacity 0.25s ease, transform 0.25s ease;
		}

		.nav-menu .nav-group {
			position: static;
		}

		.nav-menu .submenu-panel {
			position: static;
			transform: none;
			opacity: 1;
			pointer-events: auto;
			border: none;
			box-shadow: none;
			padding: 0;
			background: transparent;
			min-width: unset;
		}

		.nav-summary {
			padding: 0;
		}

		input#menu-toggle:checked + .menu-button + .nav-menu {
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
		}
	}
</style>
