<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <p class="footer-title">Malue</p>
      <p class="footer-copy">Placeholder footer content. Replace with your own links and legal text.</p>
    </div>
    <div class="footer-links">
      <div>
        <p class="footer-heading">Company</p>
        <a href="#">About</a>
        <a href="#">Careers</a>
      </div>
      <div>
        <p class="footer-heading">Resources</p>
        <a href="#">Blog</a>
        <a href="#">Contact</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
    background: var(--dark-bg);
    color: var(--off-white);
  }

  .footer-inner {
    width: min(100%, var(--site-max-width));
    margin: 0 auto;
    padding: 32px 20px;
    display: flex;
    justify-content: space-between;
    gap: 32px;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .footer-brand {
    max-width: 420px;
  }

  .footer-title {
    margin: 0 0 10px;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .footer-copy {
    margin: 0;
    line-height: 1.7;
  }

  .footer-links {
    display: flex;
    gap: 44px;
    flex-wrap: wrap;
  }

  .footer-heading {
    margin: 0 0 12px;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .footer-links a {
    display: block;
    color: var(--off-white);
    text-decoration: none;
    margin-bottom: 8px;
    transition: color 0.2s ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: #1058ff;
  }

  @media screen and (max-width: 768px) {
    .footer-inner {
      padding: 24px 18px;
      flex-direction: column;
    }

    .footer-links {
      gap: 24px;
    }
  }
</style>
