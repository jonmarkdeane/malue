---
import { Image } from "astro:assets";
import logoWhite from "@assets/logo-white.svg";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <Image class="footer-logo" src={logoWhite} alt="Malue" />
      <p class="footer-copy">
        Building an incentivised decision intelligence and adoption support
        ecosystem that turns collective experience into measurable improvement.
      </p>
      <p class="footer-copy">&copy; 2026 Malue Ltd. All rights reserved.</p>
    </div>
    <div class="footer-links">
      <div>
        <a href="#">Item</a>
        <a href="#">Item</a>
      </div>
      <div>
        <a href="#">Terms of Use</a>
        <a href="./privacy">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
    background: var(--dark-bg);
    color: var(--off-white);
  }

  .footer-inner {
    width: min(100%, var(--site-max-width));
    margin: 0 auto;
    padding: 80px 0;
    display: flex;
    justify-content: space-between;
    gap: 32px;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .footer-brand {
    max-width: 420px;
  }

  .footer-logo {
    display: block;
    width: 150px;
    height: auto;
    margin-bottom: 50px;
  }

  .footer-copy {
    text-wrap: balance;
    margin: 80px 0 0;
    font-size: 0.95rem;
    font-weight: 100;
    line-height: 1.45;
  }

  .footer-links {
    display: flex;
    gap: 44px;
    flex-wrap: wrap;
  }

  .footer-heading {
    margin: 0 0 12px;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .footer-links a {
    display: block;
    color: var(--off-white);
    text-decoration: none;
    margin-bottom: 8px;
    transition: color 0.2s ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: #1058ff;
  }

  @media screen and (max-width: 768px) {
    .footer-inner {
      padding: 24px 18px;
      flex-direction: column;
    }

    .footer-links {
      gap: 24px;
    }
  }
</style>
