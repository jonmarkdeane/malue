---
export interface Props {
  titleHtml: string;
}

const { titleHtml } = Astro.props as Props;
---

<div class="wrapper">
  <section class="simple-block">
    <div class="block-copy">
      <h2 set:html={titleHtml} />
      <slot />
    </div>
  </section>
</div>

<style>
 

  .block-copy {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  h2 {
    text-align: center;
  }

  .block-copy p {
    margin: 0 0 18px;
    color: #475569;
    line-height: 1.8;
    font-size: 1.05rem;
  }

  .block-copy p:last-child {
    margin-bottom: 0;
  }
</style>
