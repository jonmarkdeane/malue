---
<div class="nav-container">
  <input
    type="checkbox"
    id="menu-toggle"
    aria-label="Toggle navigation menu"
  />
  <label for="menu-toggle" class="menu-button" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </label>

  <nav class="nav-menu" aria-label="Primary navigation">
    <div class="nav-links">
      <a href="./about" class="nav-link">About</a>
      <details class="nav-group">
        <summary class="nav-link nav-summary">What we do</summary>
        <div class="submenu-panel">
          <a href="#" class="dropdown-link">Item</a>
          <a href="#" class="dropdown-link">Item</a>
          <a href="#" class="dropdown-link">Item</a>
        </div>
      </details>
      <details class="nav-group">
        <summary class="nav-link nav-summary">How we work</summary>
        <div class="submenu-panel">
          <a href="#" class="dropdown-link">Item</a>
          <a href="#" class="dropdown-link">Item</a>
          <a href="#" class="dropdown-link">Item</a>
        </div>
      </details>
      <details class="nav-group">
        <summary class="nav-link nav-summary">Investors</summary>
        <div class="submenu-panel">
          <a href="#" class="dropdown-link">Item</a>
          <a href="#" class="dropdown-link">Item</a>
          <a href="#" class="dropdown-link">Item</a>
        </div>
      </details>
    </div>
    <a href="#" class="cta-button">Partner With Us</a>
  </nav>
</div>

<style>
  input#menu-toggle {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .menu-button {
    display: none;
    width: 40px;
    height: 32px;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    background: transparent;
    position: relative;
  }

  .menu-button span {
    display: block;
    width: 100%;
    height: 3px;
    border-radius: 999px;
    background: #111827;
  }

  .nav-container {
    position: relative;
    width: 100%;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 24px;
    flex: 1;
    min-width: 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex: 1;
    min-width: 0;
  }

  .nav-group {
    position: relative;
  }

  .nav-summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    position: relative;
  }

  .nav-summary::after {
    content: '▾';
    font-size: 1rem;
    display: inline-block;
    transform: translateY(1px);
    color: #64748b;
  }

  .nav-group[open] .nav-summary::after {
    transform: translateY(1px) rotate(180deg);
  }

  .nav-summary::-webkit-details-marker {
    display: none;
  }

  .submenu-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 16px;
    background: white;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    box-shadow: 0 22px 45px rgba(15, 23, 42, 0.12);
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    min-width: 170px;
  }

  .nav-group[open] .submenu-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .dropdown-link {
    text-decoration: none;
    color: #475569;
    font-size: 0.95rem;
    padding: 8px 0;
    transition: color 0.2s ease;
  }

  .dropdown-link:hover,
  .dropdown-link:focus-visible {
    color: #0f172a;
  }

  .nav-link {
    text-decoration: none;
    color: #334155;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-summary:hover,
  .nav-summary:focus-visible {
    color: #111827;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--brand-cta);
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .cta-button:hover,
  .cta-button:focus-visible {
    background: #b5b5b5;
    transform: translateY(-1px);
  }

  @media screen and (max-width: 768px) {
    .menu-button {
      display: flex;
    }

    .nav-menu {
      position: absolute;
      top: calc(100% + 14px);
      right: 0;
      left: 0;
      flex-direction: column;
      gap: 12px;
      padding: 16px 18px;
      background: rgba(255, 255, 255, 0.98);
      border: 1px solid rgba(15, 23, 42, 0.08);
      border-radius: 18px;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition:
        opacity 0.25s ease,
        transform 0.25s ease;
      z-index: 30;
    }

    .nav-container {
      display: flex;
      justify-content: flex-end;
    }

    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }

    .nav-link,
    .nav-summary {
      width: 100%;
      display: inline-flex;
      justify-content: space-between;
      padding: 12px 0;
    }

    .cta-button {
      width: 100%;
      justify-content: center;
    }

    .nav-group {
      position: static;
    }

    .submenu-panel {
      position: static;
      transform: none;
      opacity: 1;
      pointer-events: auto;
      border: none;
      box-shadow: none;
      padding: 0;
      background: transparent;
      min-width: unset;
    }

    .nav-summary {
      padding: 0;
    }

    input#menu-toggle:checked + .menu-button + .nav-menu {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }
</style>

<script type="module">
  if (typeof window !== 'undefined') {
    // Close other open <details> when one opens
    const initNavGroups = () => {
      const containers = document.querySelectorAll('.nav-container');
      containers.forEach(container => {
        const groups = Array.from(container.querySelectorAll('details.nav-group'));
        groups.forEach(g => {
          g.addEventListener('toggle', () => {
            if (g.open) {
              groups.forEach(o => { if (o !== g) o.open = false; });
            }
          });
        });

        // Close all groups when clicking outside the nav container
        document.addEventListener('click', (e) => {
          if (!container.contains(e.target)) {
            groups.forEach(o => { o.open = false; });
          }
        });
      });
    };

    // Init on DOM ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNavGroups);
    } else {
      initNavGroups();
    }
  }
</script>

